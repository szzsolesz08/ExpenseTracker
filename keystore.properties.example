# Copy to keystore.properties (git-ignored) and fill in to produce a signed release APK.
# Create a key once with (JDK keytool):
#   keytool -genkeypair -v -keystore kiadaskoveto-release.jks -alias kiadaskoveto -keyalg RSA -keysize 4096 -validity 10000
# Keep the .jks file and passwords safe: Android updates must be signed with the same key.
storeFile=kiadaskoveto-release.jks
storePassword=
keyAlias=kiadaskoveto
keyPassword=
